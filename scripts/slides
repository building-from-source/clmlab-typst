#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
package_path="$root/.typst-packages"
local_packages="$package_path/local"

link_local_package() {
  name=$1
  source=$2
  target="$local_packages/$name/1.0.0"

  if [ ! -d "$source" ]; then
    printf 'Missing local Typst package: %s\n' "$source" >&2
    exit 1
  fi

  mkdir -p "$(dirname "$target")"
  if [ -L "$target" ]; then
    linked_source=$(readlink "$target")
    if [ "$linked_source" != "$source" ]; then
      rm "$target"
    fi
  elif [ -e "$target" ]; then
    printf 'Cannot set up local package, path already exists: %s\n' "$target" >&2
    exit 1
  fi

  if [ ! -e "$target" ]; then
    ln -s "$source" "$target"
  fi
}

link_local_package ubo_typst_slides "$root/ubo_typst_slides"
link_local_package ubo_touying_utils "$root/ubo_typst_slides/ubo_touying_utils"

export TYPST_PACKAGE_PATH="$package_path"
font_path="$root/ubo_typst_slides/assets/fonts"
if [ -n "${TYPST_FONT_PATHS:-}" ]; then
  export TYPST_FONT_PATHS="$font_path:$TYPST_FONT_PATHS"
else
  export TYPST_FONT_PATHS="$font_path"
fi

action=${1:-watch}
case "$action" in
  build)
    exec typst compile --root "$root" "$root/main_slides.typ" "$root/main_slides.pdf"
    ;;
  watch)
    exec typst watch --root "$root" "$root/main_slides.typ" "$root/main_slides.pdf"
    ;;
  *)
    printf 'Usage: %s [build|watch]\n' "$0" >&2
    exit 2
    ;;
esac
